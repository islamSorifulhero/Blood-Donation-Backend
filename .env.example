# Server
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/blood_donation?schema=public"

# Redis (caching, rate limiting)
REDIS_URL="redis://default:password@localhost:6379"

# JWT
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Google Social Login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Nodemailer)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Blood Donation Platform <no-reply@blooddonation.app>"

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payment - choose one or more providers
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE=false

# Admin seed credentials (demo)
ADMIN_EMAIL="admin@blooddonation.app"
ADMIN_PASSWORD="ChangeMe123!"

# CORS
CLIENT_URL="http://localhost:3000"
